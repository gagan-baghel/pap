# ---- Next.js (set these in Vercel / your host) ----
# Written automatically by `npx convex dev`; in production use your prod deployment URL.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Used for metadataBase, OG image URLs, sitemap and robots. Must be https in production.
NEXT_PUBLIC_SITE_URL=https://pap.example.com

# Optional: a keyed tile provider once map traffic grows past OSM's fair-use policy.
# NEXT_PUBLIC_MAP_TILES=https://{s}.example-tiles.com/{z}/{x}/{y}.png?key=...

# ---- development only — never set these in production ----
# `npm run preflight -- --prod` fails the deploy if either is true.
# NEXT_PUBLIC_ALLOW_DEV_LOGIN=true
# NEXT_PUBLIC_ALLOW_DEMO_SEED=true

# ---- Convex deployment env (set with `npx convex env set …`, not in this file) ----
# JWT_PRIVATE_KEY   auth signing key      (generate once per deployment)
# JWKS              public half of it
# SITE_URL          https://pap.example.com  — also gates dev login: it only works on localhost
# ALLOW_DEV_LOGIN   development only, leave unset in production
# ALLOW_DEMO_SEED   development only, leave unset in production
